# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional server-side AI fallbacks, tried after Gemini
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Flutterwave monthly plan (keep secret keys out of source control)
FLUTTERWAVE_MONTHLY_PRICE_NGN=13310
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Optional. When set to a Flutterwave payment-plan ID, checkout becomes a
# card-only monthly subscription that Flutterwave renews automatically. Create
# the plan once in the Flutterwave dashboard (Payment Plans) or via the API.
FLUTTERWAVE_PAYMENT_PLAN_ID=
FRONTEND_URL=https://quotegen1-ai.netlify.app
