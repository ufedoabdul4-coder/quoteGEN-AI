# Frontend environment (Vite). Copy to `.env` and fill in.
#
# Base URL of the FastAPI backend. In development the Vite proxy forwards
# `/api` to localhost, so this can stay blank. In production point it at your
# deployed backend, e.g. https://quotegen-api.onrender.com
VITE_API_URL=

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
