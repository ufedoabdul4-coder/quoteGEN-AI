# quoteGEN Environment Configuration

# Google Gemini API Key (Backend AI Engine)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed browser origins for the API.
# In production set this to your frontend URL, e.g. https://quotegen.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Supabase (per-user accounts + durable storage) -------------------------
# Leave blank for local development; the app then stores files under storage/.
# When set, documents, templates, settings and profile are saved to Supabase
# and every request must carry a signed-in user's access token.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
